rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validBadmintonScore(scoreA, scoreB) {
      return (scoreA == 21 && scoreB >= 0 && scoreB <= 19)
        || (scoreB == 21 && scoreA >= 0 && scoreA <= 19)
        || (scoreA >= 22 && scoreA <= 30 && scoreB >= 20 && scoreB <= 28 && scoreA == scoreB + 2)
        || (scoreB >= 22 && scoreB <= 30 && scoreA >= 20 && scoreA <= 28 && scoreB == scoreA + 2)
        || (scoreA == 30 && scoreB == 29)
        || (scoreB == 30 && scoreA == 29);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn();
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.matchType in ['1v1', '2v2']
        && (
          (request.resource.data.matchType == '1v1'
            && request.resource.data.teamA.size() == 1
            && request.resource.data.teamB.size() == 1)
          || (request.resource.data.matchType == '2v2'
            && request.resource.data.teamA.size() == 2
            && request.resource.data.teamB.size() == 2)
        )
        && request.resource.data.scoreA is int
        && request.resource.data.scoreB is int
        && request.resource.data.scoreA >= 0
        && request.resource.data.scoreA <= 30
        && request.resource.data.scoreB >= 0
        && request.resource.data.scoreB <= 30
        && validBadmintonScore(request.resource.data.scoreA, request.resource.data.scoreB)
        && request.resource.data.winner in ['teamA', 'teamB', 'draw']
        && request.resource.data.movMultiplier is number;
      allow update: if signedIn()
        && resource.data.sessionId is string
        && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.hostId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreA', 'scoreB', 'winner', 'movMultiplier'])
        && validBadmintonScore(request.resource.data.scoreA, request.resource.data.scoreB);
      allow delete: if signedIn()
        && resource.data.sessionId is string
        && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.hostId == request.auth.uid;
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.code is string
        && request.resource.data.code.size() == 4
        && request.resource.data.closedAt == null
        && request.resource.data.playerIds.size() == 1
        && request.resource.data.playerIds[0] == request.auth.uid;
      allow update: if signedIn() && (
        (
          resource.data.hostId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'status', 'closedAt'])
          && (request.resource.data.status == resource.data.status || request.resource.data.status == 'closed')
        )
        || (
          resource.data.status == 'active'
          &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds'])
          && request.resource.data.playerIds.hasAll(resource.data.playerIds)
          && request.resource.data.playerIds.hasAny([request.auth.uid])
        )
      );
      allow delete: if false;
    }
  }
}
